# Copy to .env (git-ignored). Never commit real values.

# Required whenever the router listens beyond 127.0.0.1 (always true in Docker).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SWITCHBOARD_API_KEY=

# Optional cloud providers. Leave blank to stay fully local.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
